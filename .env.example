# 🥬 LettuVault Environment Template
# ------------------------------
# COPY THIS FILE TO ".env" AND FILL IN YOUR VALUES.
# DO NOT COMMIT THE REAL ".env" FILE TO GITHUB!

# 🚀 API BASIC INFO
PROJECT_NAME="LettuVault API"
VERSION="0.1.0"

# 🔑 SECURITY: MOBILE (JWT)
# Tip: Generate a real key using: openssl rand -hex 32
SECRET_KEY="your-secret-key-here"

# 🔐 SECURITY: HARDWARE (ESP32)
# This key must be sent by your hardware in the "X-API-KEY" header
X_API_KEY="lettuce-master-key-2024"

# 💾 STORAGE: DATABASE
# Local SQLite path (relative to project root)
# Format for SQLite: sqlite:///data/lettu_vault.db
# Format for PostgreSQL: postgresql://user:password@host:port/dbname
DATABASE_URL="sqlite:///data/lettu_vault.db"

# 📡 CONNECTIVITY: MQTT
# Public broker for development, change to your own for production
MQTT_BROKER="broker.hivemq.com"
MQTT_PORT=1883
MQTT_TOPIC="lettuvault/data"

# 🔧 HARDWARE CONFIRMATION
# true  = System config changes require ESP32 ACK before saving (production)
# false = Bypass ACK, save directly (development without hardware)
REQUIRE_ESP32_ACK=true
