# 🥬 LettuVault Environment Variables
# NEVER commit this file to GitHub in a real production environment!

PROJECT_NAME="LettuVault API"
VERSION="0.1.0"
SECRET_KEY=""
X_API_KEY=""

# 💾 Database Connection String
# For your local dev, we moved it into the /data folder to be professional.
# When you scale to production, you'd change this here without touching any code!
DATABASE_URL=""

# 📡 MQTT Settings
MQTT_BROKER=""
MQTT_PORT=1883
MQTT_TOPIC_SENSORS=""
MQTT_TOPIC_AI=""

# 🌐 Network Settings
# Use 0.0.0.0 to listen on the Hotspot, Ethernet, and Localhost all at once!
API_HOST=""
API_PORT=8000

# 🔧 Hardware Confirmation
# Set to true when ESP32 is connected (production). Set to false to bypass
# the ACK handshake so you can test system config from the mobile app without hardware.
REQUIRE_ESP32_ACK=false

# ── Hybrid Cloud Sync (sync_engine.py) ────────────────────────────────────────
# Unique identifier for this physical hardware box.
# Change this for each Raspberry Pi you deploy! (e.g. VAULT_BETA_02)
VAULT_ID="VAULT_ALPHA_01"

# Must match CLOUD_SYNC_API_KEY on the cloud server's .env
CLOUD_SYNC_API_KEY=""

# Full URL to the cloud server's /sync endpoint
# Change it to this for local testing!
# CLOUD_SYNC_URL="http://localhost:8001"

CLOUD_SYNC_URL="https://lettuvault.onrender.com"

# How often (in seconds) the sync engine checks for new data (default: 60)
SYNC_INTERVAL_SECS=60

# Max records to send per sync call (default: 100)
SYNC_BATCH_SIZE=100

# 🚀 Environment Mode
# Set to true to execute real hardware commands. false to bypass for laptop testing.
IS_PRODUCTION=false

# ☁️ Local Cloud Server Development
# When true, 'lettu_vault_start' will also automatically boot the cloud-server on port 8001
CLOUD_SERVER_LOCAL=false

VAULT_USER_EMAIL=sam@gmail.com
