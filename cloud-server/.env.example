# 🌐 LettuVault Cloud Server — Environment Variables
# Copy this file to .env and fill in real values before deploying.
# NEVER commit the real .env to Git!

# ── Cloud Database ─────────────────────────────────────────────────────────────
# Get this connection string from Neon.tech (free tier)
DATABASE_URL="postgresql://user:password@your-neon-db-host/lettu_vault_cloud"

# ── Security ───────────────────────────────────────────────────────────────────
# This key is shared between the cloud server and every Edge Vault's sync_engine.py
# Generate a strong random key: python -c "import secrets; print(secrets.token_hex(32))"
CLOUD_SYNC_API_KEY="replace-with-a-long-random-secret"

# A separate key for JWT signing (used if the mobile app queries the cloud directly)
SECRET_KEY="replace-with-another-long-random-secret"
