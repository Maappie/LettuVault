# 🌐 LettuVault Cloud Server — Environment Variables
# Copy this file to .env and fill in real values before deploying.
# NEVER commit the real .env to Git!

# ── Cloud Database ─────────────────────────────────────────────────────────────
DATABASE_URL=""

# ── Security ───────────────────────────────────────────────────────────────────
# This key is shared between the cloud server and every Edge Vault's sync_engine.py
# Generate a strong random key: python -c "import secrets; print(secrets.token_hex(32))"
CLOUD_SYNC_API_KEY=""

# A separate key for JWT signing (used if the mobile app queries the cloud directly)
SECRET_KEY=""

# ── Mobile App Auth ────────────────────────────────────────────────────────────────
# Used by the Flutter mobile app to query the cloud server in Online Mode.
# Keep this separate from CLOUD_SYNC_API_KEY so each client has its own key.
CLOUD_MOBILE_API_KEY=""
